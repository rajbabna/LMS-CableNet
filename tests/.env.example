# Copy to tests/.env and fill in. Never commit tests/.env.
# (tests/.env is covered by the root .gitignore's .env.* rule)

# Admin account (required — the suite cannot run without it)
LMS_ADMIN_EMAIL=
LMS_ADMIN_PASS=

# Student account — enables role-redirect + cross-role isolation tests
LMS_STUDENT_EMAIL=
LMS_STUDENT_PASS=

# Instructor account — enables the instructor redirect test
LMS_INSTRUCTOR_EMAIL=
LMS_INSTRUCTOR_PASS=